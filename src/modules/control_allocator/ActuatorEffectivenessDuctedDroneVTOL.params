#include <px4_platform_common/param_define.h>

// Count
PARAM_DEFINE_INT32(CA_SV_CS_COUNT, 2);

// Surface 0
PARAM_DEFINE_INT32(CA_SV_CS0_TYPE, 12); // Custom
PARAM_DEFINE_FLOAT(CA_SV_CS0_TRQ_R, 0.0f);
PARAM_DEFINE_FLOAT(CA_SV_CS0_TRQ_P, 0.0f);
PARAM_DEFINE_FLOAT(CA_SV_CS0_TRQ_Y, 0.0f);
PARAM_DEFINE_FLOAT(CA_SV_CS0_THRUST_X, 0.0f);
PARAM_DEFINE_FLOAT(CA_SV_CS0_THRUST_Y, 0.0f);
PARAM_DEFINE_FLOAT(CA_SV_CS0_THRUST_Z, 0.0f);

// Surface 1
PARAM_DEFINE_INT32(CA_SV_CS1_TYPE, 12); // Custom
PARAM_DEFINE_FLOAT(CA_SV_CS1_TRQ_R, 0.0f);
PARAM_DEFINE_FLOAT(CA_SV_CS1_TRQ_P, 0.0f);
PARAM_DEFINE_FLOAT(CA_SV_CS1_TRQ_Y, 0.0f);
PARAM_DEFINE_FLOAT(CA_SV_CS1_THRUST_X, 0.0f);
PARAM_DEFINE_FLOAT(CA_SV_CS1_THRUST_Y, 0.0f);
PARAM_DEFINE_FLOAT(CA_SV_CS1_THRUST_Z, 0.0f);